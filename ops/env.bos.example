# BOŞ BAŞLANGIÇ ortamı — apps/api/.env.bos olarak kopyalayın; sırları değiştirin. Demo verisi yoktur ve seed:demo bu ortamda çalışmaz.
HPW_ENV=bos
PORT=8788
DATABASE_URL=postgres://hpw_api_bos:BOS_API_PAROLASI@localhost:5432/hpw_act_bos
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hpw_act_bos
APP_BASE_URL=http://localhost:8788
COOKIE_NAME=hpw_session_bos
COOKIE_SECURE=false
SETUP_KEY=bos-kurulum-anahtari-degistirin
HPW_DEMO_DATA=0
MAIL_DIR=./var/mail-bos
# Onaylı sağlayıcı yapılandırılana kadar posta sandbox'a yazılır ve öyle etiketlenir; sahte "gönderildi" yok
# SMTP_URL=
# MAIL_FROM=
# MAIL_ALLOWLIST=
