# Bu dosyayı ops/sunucu/.env olarak kopyalayın ve değerleri doldurun. .env dosyası depoya ya da e-postaya konmaz.
# Rastgele değer üretmek için: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DOMAIN=act.ornek.com.tr
# Kurulan sürümün kimliği; /api/ready yanıtında "build" olarak görünür (ör. depo commit kısaltması ya da paket build kimliği)
HPW_BUILD_ID=3.0.0
PG_PASSWORD=
API_DB_PASSWORD=
SETUP_KEY=
HPW_MFA_KEY=
# Davet ve parola e-postaları için (boş bırakılırsa e-posta gönderilmez):
SMTP_URL=smtps://kullanici:parola@smtp.ornek.com:465
MAIL_FROM=hpw-act@ornek.com.tr
