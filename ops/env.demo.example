# DOLU DEMO ortamı — apps/api/.env.demo olarak kopyalayın; sırları değiştirin
HPW_ENV=demo
PORT=8787
DATABASE_URL=postgres://hpw_api_demo:DEMO_API_PAROLASI@localhost:5432/hpw_act_demo
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hpw_act_demo
APP_BASE_URL=http://localhost:8787
COOKIE_NAME=hpw_session_demo
COOKIE_SECURE=false
SETUP_KEY=demo-kurulum-anahtari-degistirin
HPW_DEMO_DATA=1
MAIL_DIR=./var/mail-demo
# Gerçek SMTP yalnız izole test kutusuna: MAIL_ALLOWLIST doluysa başka alıcıya gönderim engellenir (blocked)
