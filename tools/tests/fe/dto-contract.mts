/** N03/N04: ön yüz DTO doğrulayıcıları (apps/web/src/product/dto.ts) sözleşmedeki yanıt şemalarının alt kümesi olmalı; kontrollü test yanıtları (harness) da sözleşmeye uymalı. */
import assert from 'node:assert/strict'; import { readFileSync } from 'node:fs'; import { createRequire } from 'node:module';
import { DTO, type Schema } from '../../../apps/web/src/product/dto.ts';
import { check } from '../../../apps/api/scripts/contract-verify.mts';
type S = { type?: string | string[]; properties?: Record<string, S>; required?: string[]; items?: S };
const RESP = JSON.parse(readFileSync(new URL('../../../apps/api/src/contract/responses.json', import.meta.url), 'utf8')) as Record<string, S>;
const MAP: Record<keyof typeof DTO, string> = { planSteps: 'GET /api/t/:tid/actions/:aid/plan-steps', me: 'GET /api/auth/me', overview: 'GET /api/t/:tid/overview', permissions: 'GET /api/t/:tid/permissions', cycles: 'GET /api/t/:tid/cycles', units: 'GET /api/t/:tid/cycles/:cid/units', results: 'GET /api/t/:tid/cycles/:cid/units/:uid/results', targets: 'GET /api/t/:tid/cycles/:cid/units/:uid/targets', actions: 'GET /api/t/:tid/actions', actionDetail: 'GET /api/t/:tid/actions/:aid', recommendations: 'GET /api/t/:tid/targets/:ltid/recommendations', users: 'GET /api/t/:tid/users', org: 'GET /api/t/:tid/org', instruments: 'GET /api/t/:tid/instruments', attention: 'GET /api/t/:tid/attention', queue: 'GET /api/t/:tid/corporate/queue', deployments: 'GET /api/t/:tid/corporate/deployments', ambitions: 'GET /api/t/:tid/corporate/ambitions', portfolio: 'GET /api/platform/portfolio', platformMe: 'GET /api/platform/me', platformTenants: 'GET /api/platform/tenants', staff: 'GET /api/platform/staff', assignments: 'GET /api/platform/tenants/:tid/assignments', auditEvents: 'GET /api/platform/audit-events', mfaState: 'GET /api/platform/mfa', mfaSetup: 'POST /api/platform/mfa/setup', mfaVerify: 'POST /api/platform/mfa/verify', platformTenantDetail: 'GET /api/platform/tenants/:tid', versionResult: 'PATCH /api/platform/tenants/:tid/tracked-cycle', goLiveCustomer: 'GET /api/t/:tid/onboarding/go-live', workItems: 'GET /api/platform/work-items', workItemHistory: 'GET /api/platform/work-items/:id/history', workItemResult: 'POST /api/platform/work-items/:id/:op', commandOutcome: 'GET /api/platform/commands/:key/outcome' };
const types = (s: S) => (Array.isArray(s.type) ? s.type : s.type ? [s.type] : []);
function sub(d: Schema, c: S, p: string, errs: string[]) {
  if (d.type === 'any') return; const ct = types(c); if (!ct.length) { errs.push(`${p}: sözleşmede tür yok`); return; }
  const want = d.type === 'number' ? ['number', 'integer'] : [d.type]; if (!ct.some(t => want.includes(t))) { errs.push(`${p}: ön yüz ${d.type}, sözleşme ${ct.join('|')}`); return; }
  if (ct.includes('null') && !('nullable' in d && d.nullable) && d.type !== 'object' && d.type !== 'array') errs.push(`${p}: sözleşme null dönebilir, ön yüz null kabul etmiyor`);
  if (d.type === 'object') for (const [k, v] of Object.entries(d.required ?? {})) { const cp = c.properties?.[k]; if (!cp) { errs.push(`${p}.${k}: sözleşmede alan yok`); continue; } if (!(c.required ?? []).includes(k)) errs.push(`${p}.${k}: sözleşmede zorunlu değil, ön yüz zorunlu sayıyor`); sub(v, cp, `${p}.${k}`, errs); }
  if (d.type === 'array' && d.items) { if (!c.items) errs.push(`${p}[]: sözleşmede eleman şeması yok`); else sub(d.items, c.items, `${p}[]`, errs); }
}
const errs: string[] = []; for (const [k, op] of Object.entries(MAP)) { const c = RESP[op]; if (!c) { errs.push(`${k}: ${op} sözleşmede yok`); continue; } sub(DTO[k as keyof typeof DTO], c, k, errs); }
// kontrollü test yanıtları (harness) sözleşmeye uymalı
const H = createRequire(import.meta.url)('./harness.cjs');
const fx: [string, unknown][] = [['GET /api/t/:tid/cycles/:cid/units/:uid/results', H.conform({ cycle: { code: '2026-ANA' }, unit: { ...H.units[0] }, rows: [H.row] }, RESP['GET /api/t/:tid/cycles/:cid/units/:uid/results'])], ['GET /api/t/:tid/cycles', H.cycles], ['GET /api/t/:tid/cycles/:cid/units', H.units], ['GET /api/t/:tid/cycles/:cid/units/:uid/targets', [H.target]], ['GET /api/t/:tid/actions', [H.action]]];
for (const [op, v] of fx) { const e = check(v, RESP[op] as never, '$', true); if (e) errs.push(`fixture ${op}: ${e}`); /* test kimlikleri kısa simgeler (u1, a1…): yalnız uuid biçimi denetlenmez; tür/zorunlu/enum denetlenir */ }
console.log('DTO-SÖZLEŞME', Object.keys(MAP).length, 'uç +', fx.length, 'fixture;', errs.length, 'uyumsuzluk'); if (errs.length) { console.log(errs.join('\n')); process.exit(1); }
