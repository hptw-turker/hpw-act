/** F06/F07/F13 ek API istemcisi testleri (Node, sahte fetch + sahte sessionStorage). Denetçi testlerinin sonuç dosyasını da doğrular. */
import assert from 'node:assert/strict'; import { readFileSync, writeFileSync } from 'node:fs';
import { commandApi, setCommandContext, clearIntents, registerReconciler, parseNum } from '../../../apps/web/src/product/api.ts';
const mem = new Map<string, string>(); (globalThis as any).sessionStorage = { getItem: (k: string) => mem.get(k) ?? null, setItem: (k: string, v: string) => mem.set(k, v), removeItem: (k: string) => mem.delete(k), clear: () => mem.clear() };
(globalThis as any).window = { dispatchEvent() {}, addEventListener() {} }; (globalThis as any).CustomEvent = class { constructor(public type: string) {} };
const out: { id: string; status: string; detail?: unknown }[] = []; const OUT = process.env.OUT || 'docs/test-ciktilari/fe';
async function check(id: string, fn: () => Promise<unknown>) { mem.clear(); clearIntents(); try { const d = await fn(); out.push({ id, status: 'PASS', detail: d }); } catch (e) { out.push({ id, status: 'FAIL', detail: String(e) }); } }
const keysOf = (calls: any[]) => calls.map(c => c.headers['Idempotency-Key']);
await check('SECRET-ALL-KEYS', async () => { setCommandContext('u1', 't1'); (globalThis as any).fetch = async () => { throw new TypeError('Failed to fetch'); };
  await commandApi('/api/invitations/TOKEN-XYZ/accept', { password: 'Gizli-Parola-99' }, { retries: 0 }).catch(() => {}); await commandApi('/api/auth/reset/TOKEN-RST', { password: 'Gizli-Parola-99' }, { retries: 0 }).catch(() => {});
  const dump = JSON.stringify([...mem.entries()]); assert.ok(!dump.includes('Gizli-Parola-99') && !dump.includes('TOKEN-XYZ') && !dump.includes('TOKEN-RST'), 'depoda hassas veri: ' + dump); return { storage: dump }; });
await check('SENSITIVE-SAME-KEY-MEMORY', async () => { setCommandContext('u1', 't1'); const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); throw new TypeError('Failed to fetch'); };
  await commandApi('/api/invitations/T1/accept', { password: 'x' }, { retries: 0 }).catch(() => {}); await commandApi('/api/invitations/T1/accept', { password: 'x' }, { retries: 0 }).catch(() => {}); const k = keysOf(calls); assert.equal(new Set(k).size, 1, 'hassas komutta bellek içi aynı anahtar'); return { keys: k.length }; });
await check('ACTOR-TENANT-METHOD-SEPARATION', async () => { const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); throw new TypeError('Failed to fetch'); };
  setCommandContext('u1', 't1'); await commandApi('/api/t/t1/x', { a: 1 }, { retries: 0 }).catch(() => {}); setCommandContext('u1', 't2'); await commandApi('/api/t/t1/x', { a: 1 }, { retries: 0 }).catch(() => {}); await commandApi('/api/t/t1/x', { a: 1 }, { retries: 0, method: 'PATCH' }).catch(() => {});
  const k = keysOf(calls); assert.equal(new Set(k).size, 3, 'şirket ve yöntem ayrı niyet'); setCommandContext('u2', 't2'); assert.equal(mem.get('hpwact.intents.v2') ?? '{}', '{}', 'kullanıcı değişince önceki niyetler temizlenir'); return { keys: k.length }; });
await check('LOGOUT-CLEARS', async () => { setCommandContext('u1', 't1'); (globalThis as any).fetch = async () => { throw new TypeError('Failed to fetch'); }; await commandApi('/api/t/t1/y', { b: 1 }, { retries: 0 }).catch(() => {}); assert.ok((mem.get('hpwact.intents.v2') ?? '{}').length > 2); clearIntents(); assert.equal(mem.get('hpwact.intents.v2') ?? null, null); return {}; });
await check('RECEIPT-LOST-READ-FAIL-KEEPS-KEY', async () => { setCommandContext('u1', 't1'); const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); return new Response(JSON.stringify({ error: 'receipt_lost', message: 'x' }), { status: 409 }); };
  const un = registerReconciler(async () => { throw new Error('okunamadı'); }); const e1: any = await commandApi('/api/t/t1/z', {}, { retries: 0 }).catch(e => e); const e2: any = await commandApi('/api/t/t1/z', {}, { retries: 0 }).catch(e => e); un();
  assert.equal(e1.code, 'receipt_lost_unreconciled'); assert.equal(new Set(keysOf(calls)).size, 1, 'okunamadıysa aynı anahtar');
  const un2 = registerReconciler(async () => true); const e3: any = await commandApi('/api/t/t1/z', {}, { retries: 0 }).catch(e => e); un2(); assert.equal(e3.code, 'receipt_lost_unverified', 'yalnız okuma: niyet açık'); assert.equal(new Set(keysOf(calls)).size, 1);
  const e4: any = await commandApi('/api/t/t1/z', {}, { retries: 0, verify: async () => true }).catch(e => e); assert.equal(e4.code, 'receipt_lost', 'doğrulandı: kapanır'); await commandApi('/api/t/t1/z', {}, { retries: 0 }).catch(() => {}); assert.equal(new Set(keysOf(calls)).size, 2, 'doğrulamadan sonra yeni niyet yeni anahtar'); return { calls: calls.length }; });
await check('N01-NO-RECONCILER-KEEPS-KEY', async () => { setCommandContext('u1', 't1'); const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); return new Response(JSON.stringify({ error: 'receipt_lost', message: 'x' }), { status: 409 }); };
  const e1: any = await commandApi('/api/t/t1/org/units', { code: 'N' }, { retries: 0 }).catch(e => e); const e2: any = await commandApi('/api/t/t1/org/units', { code: 'N' }, { retries: 0 }).catch(e => e); assert.equal(e1.code, 'receipt_lost_unreconciled'); assert.ok(!/yeniden okundu/.test(e1.message), 'okuma yapılmadan okundu denmez'); assert.equal(new Set(keysOf(calls)).size, 1); return { calls: calls.length }; });
await check('N01-VERIFY-FALSE-KEEPS-KEY', async () => { setCommandContext('u1', 't1'); const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); return new Response(JSON.stringify({ error: 'receipt_lost', message: 'x' }), { status: 409 }); };
  const e1: any = await commandApi('/api/t/t1/org/units', { code: 'M' }, { retries: 0, verify: async () => false }).catch(e => e); await commandApi('/api/t/t1/org/units', { code: 'M' }, { retries: 0, verify: async () => false }).catch(() => {}); assert.equal(e1.code, 'receipt_lost_unverified'); assert.equal(new Set(keysOf(calls)).size, 1); return {}; });
await check('N01-CONTEXT-CHANGED', async () => { setCommandContext('u1', 't1'); let ctx = 'birimA'; const calls: any[] = []; (globalThis as any).fetch = async (_u: string, o: any) => { calls.push(o); ctx = 'birimB'; return new Response(JSON.stringify({ error: 'receipt_lost', message: 'x' }), { status: 409 }); };
  let reads = 0; const un = registerReconciler(async () => { reads++; }, () => ctx); const e1: any = await commandApi('/api/t/t1/actions/a1/declare-complete', {}, { retries: 0 }).catch(e => e); un(); assert.equal(e1.code, 'receipt_lost_unreconciled', 'bağlam değişti: başka birimin okunmasıyla uzlaştırılmaz'); assert.equal(reads, 0); return {}; });
await check('PARSE-NUM', async () => { const r = (s: string) => parseNum(s, { min: 0, max: 100, label: 'Değer' });
  assert.deepEqual(r('72,5'), { ok: true, value: 72.5 }); assert.deepEqual(r('0'), { ok: true, value: 0 }); assert.deepEqual(r(''), { ok: true, value: null }); for (const bad of ['abc', '-1', '101', '1e2', '12,3,4', 'NaN']) assert.equal(r(bad).ok, false, bad); return {}; });
// Denetçi API istemcisi sonuçları: hepsi PASS olmalı
await check('AUDIT-API-CLIENT-RESULTS', async () => { const a = JSON.parse(readFileSync(OUT + '/api-client-results.json', 'utf8')); const bad = a.filter((x: any) => x.status !== 'PASS'); assert.equal(bad.length, 0, JSON.stringify(bad)); return { checks: a.length }; });
writeFileSync(OUT + '/api-client-extra-results.json', JSON.stringify(out, null, 2)); const f = out.filter(x => x.status !== 'PASS'); console.log('API İSTEMCİSİ EK', out.length, 'BAŞARISIZ', f.length, f.map(x => x.id + ': ' + x.detail).join(' | ')); process.exit(f.length ? 1 : 0);
